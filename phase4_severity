"""
Phase 4 — Severity Scoring
Takes every window with a THREAT or WARNING verdict from Phase 3
and assigns a severity level: LOW, MEDIUM, HIGH, or CRITICAL.

Severity is computed from four contextual inputs:
  1. Threat class     — what it is (base score)
  2. Proximity        — estimated from signal RMS (louder = closer)
  3. Time of day      — unsocial hours weight up sharply
  4. Persistence      — repeated detections at the same label escalate

No single input alone produces CRITICAL. Context is what turns
a detection into a decision.

Usage:
    python phase4_severity.py

Output:
    cache/phase4_results.csv    — per-window severity + full context
    cache/phase4_report.txt     — human readable summary
    cache/thresholds.json       — updated with severity config
"""

import json
import time
import logging
import warnings
import numpy as np
import pandas as pd
from pathlib import Path
from collections import defaultdict

warnings.filterwarnings("ignore")

# ------------------------------------------------------------------ config
BASE  = Path(__file__).parent
CACHE = BASE / "cache"

# base severity scores per class (0-100 scale)
CLASS_BASE_SCORE = {
    "gunshot"      : 85,
    "siren"        : 70,
    "vehicle"      : 60,
    "person"       : 75,
    "animal"       : 10,
    "environmental": 5,
}

# time of day multipliers (applied to base score)
# hour -> multiplier
# unsocial hours (22:00 - 06:00) weight up sharply
def time_multiplier(hour: int) -> float:
    if 0 <= hour < 6:    return 1.40   # deep night — maximum concern
    if 6 <= hour < 8:    return 1.10   # early morning
    if 8 <= hour < 18:   return 0.75   # working hours — routine activity likely
    if 18 <= hour < 20:  return 0.90   # evening
    if 20 <= hour < 22:  return 1.10   # late evening
    return 1.30                        # 22:00-24:00 — night

# proximity score from RMS (louder = closer = higher score)
# RMS percentile thresholds calibrated from Phase 1 data
PROX_WEIGHT = 15   # max points from proximity

# persistence bonus per consecutive detection of same class
# caps at 3 repetitions
PERSISTENCE_BONUS = {1: 0, 2: 8, 3: 15, 4: 20}  # capped at 4+

# severity buckets
def score_to_level(score: float) -> str:
    if score >= 80: return "CRITICAL"
    if score >= 60: return "HIGH"
    if score >= 35: return "MEDIUM"
    return "LOW"

SEVERITY_ORDER = {"CRITICAL": 3, "HIGH": 2, "MEDIUM": 1, "LOW": 0}

# ------------------------------------------------------------------ logging
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s  %(message)s",
    handlers=[
        logging.FileHandler(CACHE / "phase4_log.txt", mode="w"),
        logging.StreamHandler(),
    ],
)
log = logging.getLogger()


# ------------------------------------------------------------------ load
def load_data():
    log.info("Loading Phase 3 results ...")
    df = pd.read_csv(CACHE / "phase3_results.csv")

    with open(CACHE / "thresholds.json") as fh:
        thresh = json.load(fh)

    log.info(f"  Total windows : {len(df)}")
    log.info(f"  Verdicts      :")
    for v in ["THREAT", "WARNING", "CLEAR"]:
        log.info(f"    {v:7} : {(df['verdict'] == v).sum()}")

    return df, thresh


# ------------------------------------------------------------------ proximity
def compute_proximity_score(rms_series: pd.Series) -> pd.Series:
    """
    Map RMS energy to a proximity score 0-PROX_WEIGHT.
    Louder signal = closer source = higher proximity score.
    Uses percentile-based normalisation so scores are stable
    across different recording conditions.
    """
    p5  = rms_series.quantile(0.05)
    p95 = rms_series.quantile(0.95)
    norm = (rms_series - p5) / (p95 - p5 + 1e-8)
    norm = norm.clip(0, 1)
    return (norm * PROX_WEIGHT).round(1)


# ------------------------------------------------------------------ persistence
def compute_persistence(df: pd.DataFrame) -> pd.Series:
    """
    Count consecutive detections of the same freq_class per source.
    Uses window_idx to determine ordering within each file.
    """
    persistence = pd.Series(1, index=df.index)

    # group by file + freq_class, count consecutive windows
    for (fname, cls), grp in df.groupby(["file", "freq_class"]):
        if len(grp) < 2:
            continue
        # sort by window index within the file
        grp_sorted = grp.sort_values("window_idx")
        counts = []
        run = 1
        for i, (idx, row) in enumerate(grp_sorted.iterrows()):
            if i == 0:
                counts.append((idx, run))
                continue
            prev_idx = grp_sorted.index[i - 1]
            # consecutive if window_idx increments by 1
            if (row["window_idx"] -
                    grp_sorted.loc[prev_idx, "window_idx"]) == 1:
                run += 1
            else:
                run = 1
            counts.append((idx, run))
        for idx, cnt in counts:
            persistence[idx] = cnt

    return persistence


# ------------------------------------------------------------------ simulate time
def simulate_time_of_day(df: pd.DataFrame) -> pd.Series:
    """
    Since our dataset has no real timestamps, we simulate a 24h
    distribution weighted toward unsocial hours for threats
    (to demonstrate the scoring mechanism).

    In a real deployed system this would read from the node timestamp.
    """
    np.random.seed(42)
    n = len(df)

    # threats more likely at night in the simulation
    threat_mask = df["role"] == "threat"
    hours = np.zeros(n, dtype=int)

    # non-threats: uniform across day
    hours[~threat_mask] = np.random.randint(0, 24, (~threat_mask).sum())

    # threats: weighted toward unsocial hours
    threat_hours = np.random.choice(
        [0,1,2,3,4,22,23, 8,9,10,14,15,16],
        size=threat_mask.sum(),
        p=[0.08,0.08,0.08,0.08,0.08,0.08,0.08,
           0.07,0.07,0.07,0.07,0.07,0.09]
    )
    hours[threat_mask] = threat_hours

    return pd.Series(hours, index=df.index, name="hour")


# ------------------------------------------------------------------ score
def compute_severity(df: pd.DataFrame) -> pd.DataFrame:
    log.info("\nComputing severity scores ...")

    df = df.copy()

    # only score THREAT and WARNING windows
    active = df["verdict"].isin(["THREAT", "WARNING"])
    df["severity_score"] = 0.0
    df["severity"]       = "CLEAR"
    df["hour"]           = simulate_time_of_day(df)

    prox_scores = compute_proximity_score(df["rms"])
    persistence = compute_persistence(df)

    df["proximity_score"] = prox_scores
    df["persistence"]     = persistence

    scored = df[active].copy()

    # 1. base score from class
    base = scored["freq_class"].map(CLASS_BASE_SCORE).fillna(30)

    # 2. time of day multiplier
    t_mult = scored["hour"].apply(time_multiplier)

    # 3. proximity bonus
    prox_bonus = prox_scores[active]

    # 4. persistence bonus
    def pers_bonus(n):
        return PERSISTENCE_BONUS.get(min(n, 4), 20)
    pers_bonus_vals = persistence[active].apply(pers_bonus)

    # combine
    score = (base * t_mult) + prox_bonus + pers_bonus_vals
    score = score.clip(0, 100)

    df.loc[active, "severity_score"] = score.round(1)
    df.loc[active, "severity"]       = score.apply(score_to_level)

    # CLEAR windows always LOW severity
    df.loc[~active, "severity"] = "CLEAR"

    log.info("\n  Severity distribution (THREAT + WARNING windows only):")
    active_df = df[active]
    for lvl in ["CRITICAL", "HIGH", "MEDIUM", "LOW"]:
        n = (active_df["severity"] == lvl).sum()
        log.info(f"    {lvl:8} : {n:6}  "
                 f"({100*n/max(len(active_df),1):.1f}%)")

    return df


# ------------------------------------------------------------------ metrics
def severity_metrics(df: pd.DataFrame):
    log.info("\nSeverity scoring metrics:")

    # how many real threats reach each severity level
    threat_df = df[df["role"] == "threat"]
    log.info("\n  Real threat windows by severity:")
    for lvl in ["CRITICAL", "HIGH", "MEDIUM", "LOW", "CLEAR"]:
        n = (threat_df["severity"] == lvl).sum()
        log.info(f"    {lvl:8} : {n:6}  "
                 f"({100*n/max(len(threat_df),1):.1f}% of threats)")

    # false alarm class severity distribution
    fa_df = df[df["role"] == "false_alarm"]
    log.info("\n  Animal/false_alarm windows by severity:")
    for lvl in ["CRITICAL", "HIGH", "MEDIUM", "LOW", "CLEAR"]:
        n = (fa_df["severity"] == lvl).sum()
        log.info(f"    {lvl:8} : {n:6}  "
                 f"({100*n/max(len(fa_df),1):.1f}% of animals)")

    # the key metric: animals reaching CRITICAL or HIGH
    animals_critical = ((fa_df["severity"] == "CRITICAL") |
                        (fa_df["severity"] == "HIGH")).sum()
    log.info(f"\n  Animals reaching HIGH or CRITICAL : {animals_critical}")
    log.info(f"  (Target: as close to 0 as possible)")

    # worked example: show a few high-severity threat windows
    log.info("\n  Sample CRITICAL threat windows:")
    critical = df[(df["severity"] == "CRITICAL") &
                  (df["role"] == "threat")].head(5)
    for _, row in critical.iterrows():
        log.info(f"    label={row['label']:15}  "
                 f"score={row['severity_score']:5.1f}  "
                 f"hour={row['hour']:2d}:00  "
                 f"persistence={int(row['persistence'])}")

    # severity escalation example
    log.info("\n  Severity escalation demonstration:")
    log.info("  Same gunshot class at different contexts:")
    for hour, label, persist in [(14, "gunshot", 1),
                                  (3,  "gunshot", 1),
                                  (3,  "gunshot", 3)]:
        base   = CLASS_BASE_SCORE.get("gunshot", 60)
        t_mult = time_multiplier(hour)
        pers   = PERSISTENCE_BONUS.get(min(persist, 4), 20)
        score  = base * t_mult + 5 + pers   # assume mid proximity
        level  = score_to_level(score)
        log.info(f"    Hour={hour:2d}:00  persist={persist}  "
                 f"score={score:.0f}  -> {level}")

    stats = {
        "threats_critical" : int((threat_df["severity"] == "CRITICAL").sum()),
        "threats_high"     : int((threat_df["severity"] == "HIGH").sum()),
        "threats_medium"   : int((threat_df["severity"] == "MEDIUM").sum()),
        "threats_low"      : int((threat_df["severity"] == "LOW").sum()),
        "animals_high_plus": int(animals_critical),
    }
    return stats


# ------------------------------------------------------------------ save
def save_results(df: pd.DataFrame, stats: dict, thresh: dict):
    results_path = CACHE / "phase4_results.csv"
    df.to_csv(results_path, index=False)
    log.info(f"\n  Results saved    -> {results_path}")

    thresh.update({
        "severity_buckets"  : ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
        "class_base_scores" : CLASS_BASE_SCORE,
        "severity_metrics"  : stats,
    })
    with open(CACHE / "thresholds.json", "w") as fh:
        json.dump(thresh, fh, indent=2)
    log.info(f"  Thresholds updated -> {CACHE}/thresholds.json")

    report_path = CACHE / "phase4_report.txt"
    with open(report_path, "w") as fh:
        fh.write("PHASE 4 REPORT — SEVERITY SCORING\n")
        fh.write("=" * 50 + "\n\n")
        fh.write("SCORING INPUTS\n")
        fh.write("  1. Threat class base score\n")
        fh.write("  2. Time of day multiplier\n")
        fh.write("  3. Proximity (from RMS energy)\n")
        fh.write("  4. Persistence (consecutive detections)\n\n")
        fh.write("SEVERITY METRICS\n")
        for k, v in stats.items():
            fh.write(f"  {k:25} : {v}\n")
        fh.write("\nBASE SCORES BY CLASS\n")
        for cls, score in CLASS_BASE_SCORE.items():
            fh.write(f"  {cls:15} : {score}\n")
    log.info(f"  Report saved     -> {report_path}")


# ------------------------------------------------------------------ main
if __name__ == "__main__":
    t0 = time.time()
    log.info("PERIMETER THREAT SYSTEM  —  Phase 4 Severity Scoring")

    df, thresh = load_data()

    df_scored = compute_severity(df)
    stats     = severity_metrics(df_scored)

    save_results(df_scored, stats, thresh)

    elapsed = time.time() - t0
    log.info(f"\nTotal time: {elapsed:.1f} seconds")

    print("\n" + "=" * 60)
    print("  PHASE 4 COMPLETE")
    print("=" * 60)
    print(f"\n  Threat severity breakdown:")
    print(f"    CRITICAL : {stats['threats_critical']}")
    print(f"    HIGH     : {stats['threats_high']}")
    print(f"    MEDIUM   : {stats['threats_medium']}")
    print(f"    LOW      : {stats['threats_low']}")
    print(f"\n  Animals reaching HIGH or CRITICAL : {stats['animals_high_plus']}")
    print()
    print("  Severity escalation example (gunshot class):")
    for hour, persist in [(14, 1), (3, 1), (3, 3)]:
        base  = CLASS_BASE_SCORE["gunshot"]
        score = base * time_multiplier(hour) + 5 + \
                PERSISTENCE_BONUS.get(min(persist, 4), 20)
        print(f"    {hour:02d}:00  persist={persist}  "
              f"score={score:.0f}  -> {score_to_level(score)}")
    print()
